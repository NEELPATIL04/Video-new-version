generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  host
  // A host-appointed participant who gains call-control/queue-management
  // privileges (mute, remove, admit, deny, lock/unlock, lower-hand) via
  // RoomHostOrCoHostGuard, but never room-lifecycle powers (update, cancel,
  // end) or the ability to appoint/revoke other co-hosts — those stay on
  // RoomHostGuard, checked strictly against Room.hostId. See FEATURES.md's
  // Research notes for why this is a DB-backed role (authorization-facing)
  // rather than LiveKit participant metadata (which raise-hand already
  // uses for genuinely ephemeral call state).
  cohost
  participant
  viewer
}

enum RoomStatus {
  scheduled
  active
  ended
}

enum RecordingStatus {
  processing
  ready
  failed
}

enum PollStatus {
  open
  closed
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Brute-force protection: incremented on failed login, reset on success.
  // lockedUntil blocks login attempts entirely until this timestamp passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  hostedRooms       Room[]             @relation("RoomHost")
  participants      Participant[]
  refreshTokens     RefreshToken[]
  createdPolls      Poll[]
  pollVotes         PollVote[]
  whiteboardStrokes WhiteboardStroke[]
  meetingTemplates  MeetingTemplate[]  @relation("MeetingTemplateHost")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  // Only the hash is stored — a DB leak alone never yields a usable token.
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  // Set when this token is rotated out for a new one. If a token with
  // replacedByTokenId set is ever presented again, it's a reuse/theft
  // signal — the service revokes the whole chain when it sees this.
  replacedByTokenId String?
  createdAt         DateTime @default(now())
  userAgent         String?
  ipAddress         String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Room {
  id              String     @id @default(uuid())
  name            String
  status          RoomStatus @default(scheduled)
  scheduledFor    DateTime?
  maxParticipants Int        @default(100)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // A short, human-typeable alternative to sharing the full room ID/URL
  // (Zoom/Meet-style numeric code). Generated once at creation; never
  // reused even after a room ends, since an old code silently starting to
  // resolve to a different, unrelated room later would be a genuine
  // security surprise for anyone who kept a stale code around.
  joinCode String @unique

  // Host-controlled: blocks brand-new joiners from RoomsService.joinRoom
  // while true. Deliberately does NOT affect anyone who already has a
  // Participant row for this room (see joinRoom's own comment) — "locked"
  // means "no new people," not "kick out anyone who blinks," so an
  // already-admitted participant reconnecting after a network drop, and
  // the host themselves, are never affected by this flag.
  locked Boolean @default(false)

  // Chosen once at creation, never toggled mid-call — the actual
  // encryption key never touches this row (or any other server-side
  // state): it's generated client-side and shared only via the room
  // URL's fragment (`#key=...`), which browsers never send to any
  // server. This flag exists purely so the join flow can tell a client
  // "this room needs a key you don't have" (e.g. joining via the 9-digit
  // code, which can't carry a fragment) instead of silently connecting
  // with broken, undecryptable media. See FEATURES.md's Research notes.
  e2eeEnabled Boolean @default(false)

  // Chosen once at creation, same as e2eeEnabled — no live mid-call
  // toggle, since reclassifying already-connected participants' publish
  // rights mid-call has no safe moment that couldn't race with a join.
  // When true, RoomsService.joinRoom assigns new (non-host) joiners
  // RoomRole.viewer instead of 'participant' — view-only, but still able
  // to chat/react/raise-hand/vote (see LiveKitService.createAccessToken's
  // grant). A host promotes any attendee to present via the existing
  // co-host mechanism (RoomsService.promoteToCoHost), reused as-is
  // rather than a new narrower role — see FEATURES.md's Research notes.
  webinarMode Boolean @default(false)

  hostId String
  host   User   @relation("RoomHost", fields: [hostId], references: [id])

  participants      Participant[]
  recordings        Recording[]
  polls             Poll[]
  whiteboardStrokes WhiteboardStroke[]
  breakoutRooms     BreakoutRoom[]
  agendaItems       AgendaItem[]

  @@map("rooms")
}

model Participant {
  id       String    @id @default(uuid())
  role     RoomRole
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  // null = sitting in the waiting room, not yet let into the call. Set
  // once, at creation for the host (auto-admitted) or by a host's admit
  // action for anyone else — never reset on a later reconnect, so a
  // flaky connection doesn't force a returning participant back through
  // the waiting room.
  admittedAt DateTime?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // null = not currently assigned to a breakout (i.e. in the main room).
  // Set by the host's assign action, cleared when the host ends breakouts
  // for the room (or, in principle, by a future "move back" action). This
  // lives on the SAME Participant row as the main room membership rather
  // than a separate join table — a participant can only ever be assigned
  // to one breakout room at a time, so there is no many-to-many shape to
  // model here, just one more piece of this participant's current state
  // in this meeting (see FEATURES.md's Research notes for the fuller
  // reasoning on reusing Participant instead of inventing new rows).
  breakoutRoomId String?
  breakoutRoom   BreakoutRoom? @relation(fields: [breakoutRoomId], references: [id])

  @@unique([roomId, userId])
  @@map("participants")
}

// A breakout room is just another ordinary LiveKit room under the hood
// (created via RoomServiceClient.createRoom(), same as the main Room),
// scoped to a single parent meeting and never independently joinable —
// there is deliberately no joinCode, scheduledFor, or status field here;
// see FEATURES.md's Research notes for why this is a new, minimal model
// rather than a self-referencing Room.
model BreakoutRoom {
  id    String @id @default(uuid())
  // Host-assigned display name, e.g. "Room 1" — no uniqueness constraint
  // needed; these are ephemeral and scoped to a single meeting.
  label String

  createdAt DateTime  @default(now())
  // Set once by the host's "end breakouts" action; null while open. Kept
  // as a real row (not deleted) so a client whose disconnect/reconnect
  // races the end action can still resolve what happened, matching how
  // Room itself keeps ended rooms around rather than deleting them.
  endedAt   DateTime?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  participants Participant[]

  @@map("breakout_rooms")
}

model Recording {
  id          String          @id @default(uuid())
  storageUrl  String?
  durationSec Int?
  status      RecordingStatus @default(processing)
  createdAt   DateTime        @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  @@map("recordings")
}

// Unlike a reaction or a raised hand (ephemeral call state, never written
// to Postgres — see FEATURES.md's Research notes on raise-hand), a poll's
// question/options/votes are genuinely persisted: results must survive a
// page refresh and be auditable after the fact, much closer in spirit to
// Participant.admittedAt than to anything LiveKit-only. Single-question,
// multiple-choice, one open poll per room at a time (PollsService enforces
// that — see its own comment).
model Poll {
  id        String     @id @default(uuid())
  question  String
  status    PollStatus @default(open)
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

// A separate model (not a `String[]` column on Poll) specifically so a
// per-option vote count can be read as a DB-level aggregate
// (`_count: { select: { votes: true } }`) instead of pulling every vote
// row into app memory and counting client-side — see FEATURES.md's
// Research notes for the fuller reasoning.
model PollOption {
  id   String @id @default(uuid())
  text String
  // Preserves the host's original ordering (Prisma/Postgres don't
  // otherwise guarantee row order) — options are displayed and voted on
  // in the order the host defined them, not insertion-incidental order.
  order Int

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])

  votes PollVote[]

  @@map("poll_options")
}

// One row per (poll, user) — the unique constraint is what actually makes
// "a participant can vote only once per poll" true; the service layer
// checks it first for a clean 409, but the constraint is the real
// guarantee under a race (two tabs voting at once).
model PollVote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@map("poll_votes")
}

// Persisted so a participant who joins the call AFTER strokes have
// already been drawn can fetch the current canvas via REST on mount,
// instead of silently seeing a blank canvas — a plain LiveKit data-
// channel broadcast (used for live sync between already-connected
// participants) is fire-and-forget and would otherwise miss them
// entirely, the exact same late-joiner gap raise-hand's Research notes
// already worked through for participant metadata. See FEATURES.md's
// Research notes for the full alternatives comparison (this vs. a
// peer-resync protocol with no backend persistence at all).
//
// `points` stores the whole freehand stroke as one row (an array of
// normalized 0-1 {x,y} coordinates, sampled from pointermove events) —
// one row per pen-down-to-pen-up gesture, not one row per point, which
// keeps "undo my last stroke" a single-row delete rather than needing
// to group points by some synthetic stroke id.
model WhiteboardStroke {
  id        String   @id @default(uuid())
  points    Json
  color     String
  width     Int      @default(3)
  createdAt DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Never a client-supplied value — always the authenticated caller's own
  // id (see RoomsService.addWhiteboardStroke/undoLastWhiteboardStroke).
  // "Undo" is scoped to the caller's own most recent stroke via this
  // column, never a client-supplied stroke id, so nobody can undo
  // someone else's contribution.
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([roomId, createdAt])
  @@map("whiteboard_strokes")
}

// A reusable, user-owned preset that prefills the "create room" form — NOT
// room-scoped and has no relation to any Room row at all (unlike everything
// else in this schema, which hangs off a specific meeting). Ownership is
// checked with a plain `hostId` comparison inside TemplatesService, the
// same lightweight pattern RoomsService already uses for
// findRoomByCode/getRoomById-style checks — there's no room-scoped guard to
// reuse here since this resource isn't room-scoped, so a new dedicated
// guard class would be one-call-site machinery for no real benefit.
model MeetingTemplate {
  id                 String   @id @default(uuid())
  name               String
  defaultE2eeEnabled Boolean  @default(false)
  // The starter agenda as plain titles, not a relation to AgendaItem —
  // applying a template only ever COPIES these into fresh AgendaItem rows
  // for a brand-new Room (see RoomsService.createRoom); a template itself
  // never gets checked off, reordered, or otherwise mutated as "the
  // agenda" the way a real room's AgendaItem rows are, so it doesn't need
  // that model's shape (order/completed/roomId).
  agendaItems        String[]
  createdAt          DateTime @default(now())

  hostId String
  host   User   @relation("MeetingTemplateHost", fields: [hostId], references: [id])

  @@map("meeting_templates")
}

// An ordered, per-room checklist live during a call — host/co-host manage
// it (add/remove/check off), every participant can view it. Persisted (not
// LiveKit metadata/data-channel-only) for the same late-joiner reason
// Polls/Whiteboard already established: a participant who joins mid-call
// must be able to fetch the CURRENT checklist state via REST on mount, not
// just replay live broadcasts they weren't connected for. No reorder
// endpoint in v1 — items keep creation order via `order`, a deliberate
// scope cut, not an oversight.
model AgendaItem {
  id        String   @id @default(uuid())
  title     String
  order     Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("agenda_items")
}
