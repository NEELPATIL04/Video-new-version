DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="CHANGE_ME_MIN_32_CHARS"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Local dev: run infra/livekit/docker-compose.yml (docker compose up -d),
# it always uses these well-known placeholder --dev credentials.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
